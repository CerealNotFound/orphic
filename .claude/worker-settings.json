{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(pnpm worker watch)",
      "Bash(pnpm worker claim *)",
      "Bash(pnpm worker extract *)",
      "Bash(pnpm worker check *)",
      "Bash(pnpm worker submit *)",
      "Bash(pnpm worker ask *)",
      "Bash(pnpm worker fail *)",
      "Bash(pnpm worker progress *)",
      "Bash(pnpm worker lookup *)",
      "Bash(pnpm worker tags)",
      "Bash(pnpm worker verify-url *)",
      "Read(//**/WORKER.md)",
      "Read(./worker/work/**)",
      "Edit(./worker/work/*/result.json)",
      "WebSearch"
    ],
    "deny": [
      "NotebookEdit",
      "WebFetch",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.pem)",
      "Read(//**/.ssh/**)",
      "Read(//**/.aws/**)",
      "Read(//**/.config/**)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nc *)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(sudo *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm add *)",
      "Bash(pnpm install *)",
      "Bash(pnpm dlx *)",
      "Bash(pip *)",
      "Bash(brew *)",
      "Bash(git *)",
      "Bash(sh *)",
      "Bash(bash *)",
      "Bash(zsh *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(osascript *)",
      "Bash(open *)"
    ]
  }
}
