DATABASE_URL=postgres://orphic:orphic@localhost:54329/orphic
APP_URL=http://localhost:3005
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=change-me-random
VOYAGE_API_KEY=
CRON_SECRET=change-me-random
BETTER_AUTH_SECRET=change-me-random-32-bytes
BETTER_AUTH_URL=http://localhost:3005
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development only: browse the web app as this member id without Google sign-in
ORPHIC_DEV_MEMBER_ID=
# Mac worker
ORPHIC_API_URL=http://localhost:3005
ORPHIC_WORKER_KEY=
WHISPER_MODEL=/absolute/path/to/ggml-medium.bin
# Optional: only if your Voyage key comes from MongoDB Atlas and uses a different endpoint
VOYAGE_API_URL=
# Where `pnpm worker archive` keeps downloaded files (default: ~/Orphic Archive)
ORPHIC_ARCHIVE_DIR=
# Optional: Cloudinary for large saved files (audio packs, big PDFs). Stored as private "authenticated" assets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
